# SQLite database location (default: file-based, single-user).
# For multi-user / scaled deployments, switch to:
#   DATABASE_URL=postgresql://user:pass@host:5432/rea_studio
DATABASE_URL=file:./db/custom.db

# Z.ai API key — when set, retailored reports use the real LLM via
# z-ai-web-dev-sdk. When unset, falls back to deterministic templates.
# Get a key from: https://z.ai
ZAI_API_KEY=

# Directory where uploaded APKs / binaries are stored. Must be writable by
# the Next.js process. Used by /api/upload and the runner's path-safety check.
REA_UPLOAD_DIR=./uploads

# Max upload size in MB. APKs can easily be 50-150MB.
REA_MAX_UPLOAD_MB=200

# Raise if Ghidra is slow to start on large binaries (only relevant once
# binary targets are enabled in src/lib/runner.ts).
# REA_GHIDRA_STARTUP_TIMEOUT_MS=120000

# Cosmetic — shown in the sidebar "Engine" field.
REA_ENGINE_LABEL=in-process
